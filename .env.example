# ---------------- Backend ----------------
# development | test | production
ENV=development
DEBUG=false
# true => one JSON object per log line (always on in production)
LOG_JSON=false

# Generate a strong random value:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://converge:converge@postgres:5432/converge
REDIS_URL=redis://redis:6379/0

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute

# Edits by one user within this many seconds are folded into a single history entry
VERSION_COALESCE_SECONDS=60

# ---------------- Postgres (docker-compose init) ----------------
POSTGRES_USER=converge
POSTGRES_PASSWORD=converge
POSTGRES_DB=converge

# ---------------- Frontend (build-time) ----------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
